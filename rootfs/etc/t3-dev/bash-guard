# Sourced first by /etc/bash.bashrc (interactive bash) and by
# /etc/profile.d/00-t3-dev-guard.sh (login bash).
# root: never read dev's files or use dev's PATH.
if [ "$EUID" = 0 ]; then
  export HOME=/root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
fi
# dev outside the agents' sandbox (e.g. docker exec -it t3-dev bash): move into
# it before ~/.bashrc or ~/.profile, which an agent may have changed, get read.
if [ "$EUID" = 1000 ] && { /usr/bin/grep -q '^NoNewPrivs:[[:space:]]*0' /proc/self/status \
  || [ "$(/usr/bin/readlink /proc/self/ns/user)" = "$(/usr/bin/readlink /proc/1/ns/user 2>/dev/null)" ]; }; then
  t3_dev_mode=-i
  case $- in *i*) ;; *) t3_dev_mode=-l ;; esac
  if [ -n "${BASH_EXECUTION_STRING:-}" ]; then
    exec /usr/bin/setpriv --no-new-privs -- /usr/bin/unshare --user --map-current-user -- /bin/bash "$t3_dev_mode" -c "$BASH_EXECUTION_STRING"
  fi
  exec /usr/bin/setpriv --no-new-privs -- /usr/bin/unshare --user --map-current-user -- /bin/bash "$t3_dev_mode"
  echo "t3-dev: could not enter the sandbox, refusing to continue" >&2
  exit 1
fi
# dev inside the sandbox: same environment as zsh.
if [ "$EUID" = 1000 ]; then
  . /etc/t3-dev/env.sh
fi
