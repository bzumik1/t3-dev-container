Port 2222
ListenAddress 0.0.0.0
HostKey /home/dev/.ssh/host-keys/ssh_host_ed25519_key
PidFile /run/user/1000/sshd.pid

AllowUsers dev
PermitRootLogin no
PubkeyAuthentication yes
AuthorizedKeysFile /etc/t3-dev/shared/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM no
# sshd runs in its own user namespace (no ptrace to processes without
# no_new_privs), where the root-owned keys file shows up as nobody. The keys
# file is root-owned and mounted read-only, so ownership checks add nothing.
StrictModes no
MaxAuthTries 3
LoginGraceTime 30

AllowTcpForwarding local
PermitOpen localhost:* 127.0.0.1:*
AllowAgentForwarding no
AllowStreamLocalForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no

ClientAliveInterval 60
ClientAliveCountMax 3
PrintMotd no
LogLevel VERBOSE
Subsystem sftp internal-sftp
