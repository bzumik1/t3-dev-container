if [[ $EUID -eq 0 ]]; then
  export HOME=/root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  unsetopt RCS GLOBAL_RCS
  return 0
fi
# dev outside the agents' sandbox (e.g. docker exec -it t3-dev zsh, or zsh -c):
# move into it before ~/.zshenv or ~/.zshrc, which an agent may have changed,
# get read.
if [[ $EUID == 1000 ]] && { [[ "$(</proc/self/status)" == *$'NoNewPrivs:\t0'* ]] || [[ "$(/usr/bin/readlink /proc/self/ns/user)" == "$(/usr/bin/readlink /proc/1/ns/user 2>/dev/null)" ]]; }; then
  t3_dev_args=()
  [[ -o interactive ]] && t3_dev_args+=(-i)
  [[ -o login ]] && t3_dev_args+=(-l)
  if [[ -n $ZSH_EXECUTION_STRING ]]; then
    exec /usr/bin/setpriv --no-new-privs -- /usr/bin/unshare --user --map-current-user -- /usr/bin/zsh "${t3_dev_args[@]}" -c "$ZSH_EXECUTION_STRING"
  fi
  exec /usr/bin/setpriv --no-new-privs -- /usr/bin/unshare --user --map-current-user -- /usr/bin/zsh "${t3_dev_args[@]}"
  print -u2 "t3-dev: could not enter the sandbox, refusing to continue"
  exit 1
fi
. /etc/t3-dev/env.sh
