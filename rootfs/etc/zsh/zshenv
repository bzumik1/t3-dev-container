if [[ $EUID -eq 0 ]]; then
  export HOME=/root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  unsetopt RCS GLOBAL_RCS
  return 0
fi
# dev outside the agents' sandbox (e.g. docker exec -it t3-dev zsh): move into it
# before ~/.zshrc, which an agent may have changed, gets read.
if [[ -o interactive && $EUID == 1000 ]] && { [[ "$(</proc/self/status)" == *$'NoNewPrivs:\t0'* ]] || [[ "$(/usr/bin/readlink /proc/self/ns/user)" == "$(/usr/bin/readlink /proc/1/ns/user 2>/dev/null)" ]]; }; then
  exec /usr/bin/setpriv --no-new-privs -- /usr/bin/unshare --user --map-current-user -- /usr/bin/zsh -i ${ZSH_EXECUTION_STRING:+-c "$ZSH_EXECUTION_STRING"}
fi
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export TZ="${TZ:-Europe/Prague}"
export XDG_RUNTIME_DIR=/run/user/1000
export DOCKER_HOST=unix:///run/user/1000/docker.sock
export TESTCONTAINERS_RYUK_CONTAINER_PRIVILEGED=false
export TESTCONTAINERS_HOST_OVERRIDE=localhost
export NPM_CONFIG_IGNORE_SCRIPTS=true
export NPM_CONFIG_MIN_RELEASE_AGE=3
export PNPM_CONFIG_MINIMUM_RELEASE_AGE=4320
export UV_EXCLUDE_NEWER="3 days"
export NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
export PNPM_CONFIG_REGISTRY=https://registry.npmjs.org/
export PNPM_CONFIG_MINIMUM_RELEASE_AGE_IGNORE_MISSING_TIME=false
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export EDITOR=vim
