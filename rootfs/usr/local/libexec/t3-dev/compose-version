#!/bin/bash
# Refuses to run when the compose.yml in use is older than this image needs:
# updating only the image would silently miss new security options.
required=4 # must match T3_DEV_COMPOSE in compose.yml (CI lint checks it)
have="${T3_DEV_COMPOSE:-}"
if [[ ! "$have" =~ ^[0-9]{1,6}$ ]] || (( 10#$have < required )); then
  printf '[t3-dev] CHYBA: compose.yml je zastaralý (verze %s, image potřebuje %s). Importujte nový compose.yml a seccomp.json podle README.\n' "${have:-žádná}" "$required"
  exit 1
fi
