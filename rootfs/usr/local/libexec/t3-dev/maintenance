#!/bin/bash
# Daily maintenance at 04:00 in the container's time zone. It cleans up the
# nested Docker so its data on /DATA cannot grow without bound (stopped
# containers, unused build cache and dangling images older than a week) and
# updates the agents. The running T3 server keeps its old version, and T3 on
# the owner's other devices talks only to the same version, so the server
# restarts when T3 changed. 04:00 because the restart interrupts running
# threads. "prune" or "update" runs a single step (used by the tests).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
set -uo pipefail

prune() {
  docker info >/dev/null 2>&1 || return 0
  docker container prune -f --filter "until=${MAINTENANCE_UNTIL:-168h}" >/dev/null 2>&1
  docker builder prune -f --filter "until=${MAINTENANCE_UNTIL:-168h}" >/dev/null 2>&1
  docker image prune -f --filter "until=${MAINTENANCE_UNTIL:-168h}" >/dev/null 2>&1
  printf '[t3-dev] Údržba: vnořený Docker zabírá %s.\n' "$(du -sh /var/lib/t3-dev/docker 2>/dev/null | cut -f1)"
}

t3_version() {
  /home/dev/.local/bin/t3 --version 2>/dev/null | head -1
}

update() {
  local before after
  before=$(t3_version)
  /usr/local/bin/t3-dev update-agents
  after=$(t3_version)
  if [ -n "$after" ] && [ "$after" != "$before" ]; then
    printf '[t3-dev] Údržba: %s → %s, restartuji T3 server.\n' "${before:-T3}" "$after"
    /usr/bin/python3 -I /usr/bin/supervisorctl -c /etc/t3-dev/supervisord.conf restart t3 >/dev/null
  fi
}

seconds_until() {
  local now next
  now=$(date +%s)
  next=$(date -d "today $1" +%s)
  [ "$next" -gt "$now" ] || next=$(date -d "tomorrow $1" +%s)
  echo $((next - now))
}

case "${1:-}" in
  prune) prune; exit 0 ;;
  update) update; exit ;;
esac

while true; do
  sleep "$(seconds_until 04:00)"
  prune
  update
done
