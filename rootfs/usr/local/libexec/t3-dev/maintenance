#!/bin/bash
# Daily clean-up of the nested Docker so its data on /DATA cannot grow without
# bound: unused build cache and dangling images older than a week.
set -uo pipefail

sleep 600
while true; do
  if docker info >/dev/null 2>&1; then
    docker builder prune -f --filter until=168h >/dev/null 2>&1
    docker image prune -f --filter until=168h >/dev/null 2>&1
    printf '[t3-dev] Údržba: vnořený Docker zabírá %s.\n' "$(du -sh "$HOME/.local/share/docker" 2>/dev/null | cut -f1)"
  fi
  sleep 86400
done
