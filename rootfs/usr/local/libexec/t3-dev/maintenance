#!/bin/bash
# Maintenance: ten minutes after a start and then every day at 04:00 in the
# container's time zone it cleans up the nested Docker so its data on /DATA
# cannot grow without bound (stopped containers, unused build cache and
# dangling images older than a week). At 04:00 it also updates the agents.
# T3 on the owner's other devices talks only to the same T3 version, so the
# server restarts whenever it runs another version than the t3 command, also
# after a manual update. 04:00 because the restart interrupts running threads.
# "prune" or "update" runs a single step (used by the tests).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
set -uo pipefail

supervisor() { /usr/bin/python3 -I /usr/bin/supervisorctl -c /etc/t3-dev/supervisord.conf "$@"; }

prune() {
  docker info >/dev/null 2>&1 || return 0
  docker container prune -f --filter "until=${MAINTENANCE_UNTIL:-168h}" >/dev/null 2>&1
  docker builder prune -f --filter "until=${MAINTENANCE_UNTIL:-168h}" >/dev/null 2>&1
  docker image prune -f --filter "until=${MAINTENANCE_UNTIL:-168h}" >/dev/null 2>&1
  printf '[t3-dev] Údržba: vnořený Docker zabírá %s.\n' "$(du -sh /var/lib/t3-dev/docker 2>/dev/null | cut -f1)"
}

version_in() { sed -n 's#.*/versions/\([^/]*\)/.*#\1#p' | head -1; }

installed_t3() {
  local launcher=/home/dev/.local/bin/t3 target
  target=$(readlink -f "$launcher" 2>/dev/null)
  case "$target" in */versions/*) echo "$target" | version_in ;; *) version_in 2>/dev/null <"$launcher" ;; esac
}

served_t3() {
  local pid
  pid=$(supervisor pid t3 2>/dev/null)
  case "$pid" in '' | 0 | *[!0-9]*) return 0 ;; esac
  { readlink "/proc/$pid/exe"; tr '\0' '\n' <"/proc/$pid/cmdline"; } 2>/dev/null | version_in
}

update() {
  local installed served
  timeout -k 1m 30m /usr/local/bin/t3-dev update-agents || printf '[t3-dev] Údržba: aktualizace agentů nedoběhla.\n'
  installed=$(installed_t3)
  served=$(served_t3)
  if [ -n "$installed" ] && [ -n "$served" ] && [ "$installed" != "$served" ]; then
    if supervisor restart t3 >/dev/null; then
      printf '[t3-dev] Údržba: T3 server restartován z %s na %s.\n' "$served" "$installed"
    else
      printf '[t3-dev] Údržba: restart T3 serveru na %s selhal.\n' "$installed"
    fi
  fi
}

seconds_until() {
  local now next
  now=$(date +%s)
  next=$(date -d "today $1" +%s)
  [ "$next" -gt "$now" ] || next=$(date -d "tomorrow $1" +%s)
  echo $((next - now))
}

case "${1:-}" in
  prune) prune; exit 0 ;;
  update) update; exit ;;
esac

sleep 600
prune
while true; do
  sleep "$(seconds_until 04:00)"
  prune
  update
done
