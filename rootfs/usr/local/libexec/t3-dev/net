#!/bin/bash
# Entry point of t3-dev-net (root, only CAP_NET_ADMIN, read-only): applies the
# firewall, then records the network namespace it protects in a root-owned
# volume that t3-dev mounts read-only (t3-dev starts only when that record
# matches its own namespace). Then it writes the SSH keys t3-dev may accept
# into the same volume, opens TCP 2222 only if there are keys, and holds the
# network namespace.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
unset BASH_ENV ENV CDPATH
set -euo pipefail

log() { printf '[t3-dev-net] %s\n' "$*"; }

/usr/local/libexec/t3-dev/compose-version
# shellcheck source=rootfs/usr/local/libexec/t3-dev/net-lib
. /usr/local/libexec/t3-dev/net-lib

shared=/etc/t3-dev/shared
marker="$shared/firewall"
keys_file="$shared/authorized_keys"
github_file="$shared/authorized_keys.github"
key_pattern='^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) '
github_user="${GITHUB_USER:-}"

if [ ! -d "$shared" ] || [ ! -w "$shared" ]; then
  log "CHYBA: chybí svazek $shared (compose.yml)."
  exit 1
fi
# ZimaOS creates missing bind-mount directories world-writable (0777). The
# directory belongs to root, so root can tighten it without CAP_FOWNER.
chmod 0755 "$shared"
rm -f "$marker"

case "${FIREWALL:-on}" in
  off|false|0)
    log "VAROVÁNÍ: firewall je vypnutý (FIREWALL=off), t3-dev vidí domácí síť i ostatní kontejnery."
    ;;
  *)
    /usr/local/libexec/t3-dev/firewall
    /usr/local/libexec/t3-dev/netns-id > "$marker.new"
    chmod 0644 "$marker.new"
    mv -f "$marker.new" "$marker"
    ;;
esac

if [ -n "$github_user" ]; then
  if [[ ! "$github_user" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,38})$ ]]; then
    log "CHYBA: GITHUB_USER '$github_user' není platné jméno účtu GitHub."
    exit 1
  fi
  fetched="$shared/.github.new"
  status=0
  code=$(curl -sSL --max-time 20 --max-filesize 1048576 --proto '=https' -o "$fetched" -w '%{http_code}' "https://github.com/${github_user}.keys") || status=$?
  outcome=$(classify_fetch "$status" "${code:-000}")
  if [ "$outcome" = keys ]; then
    { echo "# github=$github_user fetched=$(date +%s)"; grep -E "$key_pattern" "$fetched" || true; } > "$github_file"
    log "SSH: načteno $(grep -cvE '^#' "$github_file") klíčů uživatele $github_user z GitHubu."
  elif [ "$outcome" = none ]; then
    : > "$github_file"
    log "SSH: GitHub nezná uživatele $github_user (HTTP 404), jeho klíče nepoužívám."
  else
    header=$(head -1 "$github_file" 2>/dev/null || true)
    fetched_at="${header##*fetched=}"
    age=999999999
    if [[ "$fetched_at" =~ ^[0-9]+$ ]]; then age=$(( $(date +%s) - fetched_at )); fi
    if [[ "$header" == "# github=$github_user fetched="* ]] && [ "$age" -lt 604800 ]; then
      log "SSH: GitHub je nedostupný (HTTP ${code:-000}), používám klíče $github_user staré $((age / 3600)) h."
    else
      : > "$github_file"
      log "SSH: GitHub je nedostupný a uložené klíče nepatří $github_user nebo jsou starší 7 dní, nepoužívám je."
    fi
  fi
  rm -f "$fetched"
else
  : > "$github_file"
fi
chmod 0644 "$github_file"

{
  grep -E "$key_pattern" "$github_file" || true
  printf '%s\n' "${SSH_AUTHORIZED_KEYS:-}" | grep -E "$key_pattern" || true
} | sort -u > "$keys_file.new"
chmod 0644 "$keys_file.new"
mv -f "$keys_file.new" "$keys_file"

if [ -s "$keys_file" ]; then
  if [ -e "$marker" ]; then
    iptables-nft -w -I INPUT 1 -p tcp --dport 2222 -j ACCEPT
  fi
  log "SSH zapnuté: $(grep -c . "$keys_file") povolených klíčů, port 2222 otevřený."
else
  log "SSH je vypnuté: žádný klíč (nastavte GITHUB_USER nebo SSH_AUTHORIZED_KEYS u t3-dev-net)."
fi

touch /run/t3-dev-net-ready
exec sleep infinity
