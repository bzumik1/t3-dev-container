#!/bin/bash
# SSH server of the dev user on port 2222, key-only. The accepted keys come
# from /etc/t3-dev/shared/authorized_keys, which t3-dev-net writes (from
# GITHUB_USER and SSH_AUTHORIZED_KEYS) and t3-dev mounts read-only, so no
# process in t3-dev can add a key.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
set -euo pipefail

log() { printf '[t3-dev] %s\n' "$*"; }

keys=/etc/t3-dev/shared/authorized_keys
if [ ! -s "$keys" ]; then
  log "SSH je vypnuté: žádný klíč (nastavte GITHUB_USER nebo SSH_AUTHORIZED_KEYS u t3-dev-net)."
  until [ -s "$keys" ]; do sleep 10; done
fi

# Replaces StrictModes (off because the namespace shows root as nobody).
if [ -L "$keys" ] || [ -n "$(find "$keys" /etc/t3-dev/shared -maxdepth 0 -perm /022)" ]; then
  log "CHYBA: $keys je odkaz nebo je zapisovatelný pro skupinu či ostatní, SSH nespouštím."
  exit 1
fi

host_dir="$HOME/.ssh/host-keys"
install -d -m 0700 "$HOME/.ssh" "$host_dir"
host_key="$host_dir/ssh_host_ed25519_key"
[ -f "$host_key" ] || ssh-keygen -q -t ed25519 -N '' -C "t3-dev host key" -f "$host_key"

log "SSH: $(grep -c . "$keys") povolených klíčů."
exec /usr/sbin/sshd -D -e -f /etc/t3-dev/sshd_config
