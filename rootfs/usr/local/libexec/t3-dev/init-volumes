#!/bin/bash
# One-shot init container (root, only CAP_CHOWN, no network): hands the roots of
# the dev volumes to dev. Never follows symlinks. No mount target lies inside
# another volume, so dev cannot redirect a mount with a symlink.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
unset BASH_ENV ENV CDPATH
set -euo pipefail

log() { printf '[t3-dev-init] %s\n' "$*"; }

/usr/local/libexec/t3-dev/compose-version

for dir in /home/dev /workspace /var/lib/t3-dev/docker; do
  if [ -L "$dir" ] || [ "$(realpath -e -- "$dir" 2>/dev/null)" != "$dir" ]; then
    log "VAROVÁNÍ: $dir není skutečný adresář, vlastníka neměním."
    continue
  fi
  if [ "$(stat -c %u "$dir")" != 1000 ]; then
    chown -h 1000:1000 "$dir"
    log "$dir předán uživateli dev."
  fi
done
log "Svazky připravené."
